#!/usr/bin/env python3
"""Regenerate INDEX.md from filings. Idempotent; holds no state of its own.
State is derived by docket_lib.reduce_docket, the same function docket-lint uses."""
import os, re, sys, datetime
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from docket_lib import *

def main(store):
    now = datetime.datetime.now(datetime.timezone.utc)
    rows = []
    for d in sorted(os.listdir(store)):
        dp = os.path.join(store, d)
        if not os.path.isdir(dp) or d == ".seq" or not re.match(r"^r\d{3}", d): continue
        # Validate first: PROTOCOL 3 requires invalid filings to be excluded
        # from reduction so they never silently change derived state.
        filings, invalid, _errs, _warns, st = validate_docket(store, d)
        req = next((f for f in filings if f["fn"] == "000-request.md"), None)
        opened = req["fm"].get("date") if req else None
        age = ""
        try:
            t0 = datetime.datetime.strptime(opened, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
            h = (now - t0).total_seconds()/3600
            age = f"{h:.0f}h" if h < 48 else f"{h/24:.0f}d"
        except Exception: pass
        rows.append(dict(id=d.split("-")[0], dir=d, title=title(req["text"]) if req else "(no request)",
                         status=st["status"], requester=st["requester"] or "?",
                         assignee=st["assignee"], blocked=st["blocked_on"],
                         waiting=st.get("waiting_on"),
                         age=age, filings=st["count"]))
    openr = [r for r in rows if r["status"] not in TERMINAL]
    done  = [r for r in rows if r["status"] in TERMINAL]
    unclaimed = [r for r in openr if not r["assignee"]]
    out = ["# Index", "",
           f"*Generated by `tools/docket-index` at {now.strftime('%Y-%m-%dT%H:%M:%SZ')}. "
           "Do not edit — every fact here is derived from the filings by "
           "`docket_lib.reduce_docket`, the same reduction `docket-lint` uses.*", ""]
    if unclaimed:
        out += ["## ⚠ Unclaimed", "", "Open with no assignee — with three or more parties "
                "these are the ones everybody assumes somebody else is handling.", "",
                "| docket | title | opened by |", "| --- | --- | --- |"]
        out += [f"| `{r['id']}` | {r['title']} | `{r['requester']}` |" for r in unclaimed] + [""]
    byparty = {}
    for r in openr:
        if r["waiting"]: byparty.setdefault(r["waiting"], []).append(r["id"])
    if byparty:
        out += ["## Whose turn", "",
                "Docket is pull-only — nothing here wakes anybody. This is the list "
                "for whoever schedules parties.", ""]
        out += [f"- `{p}`: {', '.join(sorted(v))}" for p, v in sorted(byparty.items())] + [""]
    out += [f"## Open ({len(openr)})", "",
            "| docket | title | status | assignee | waiting on | filings | age |",
            "| --- | --- | --- | --- | --- | --- | --- |"]
    for r in openr:
        s2 = r["status"] + (f" ({r['blocked']})" if r["blocked"] else "")
        out.append(f"| [`{r['id']}`]({r['dir']}/) | {r['title']} | {s2} | "
                   f"{'`'+r['assignee']+'`' if r['assignee'] else '—'} | "
                   f"{'`'+r['waiting']+'`' if r['waiting'] else '—'} | "
                   f"{r['filings']} | {r['age']} |")
    out += ["", f"## Closed ({len(done)})", ""]
    if done:
        out += ["| docket | title | status |", "| --- | --- | --- |"]
        out += [f"| [`{r['id']}`]({r['dir']}/) | {r['title']} | {r['status']} |" for r in done]
    else: out += ["*None yet.*"]
    open(os.path.join(store, "INDEX.md"), "w", encoding="utf-8", newline="\n").write(
        "\n".join(out) + "\n")
    print(f"INDEX.md: {len(openr)} open ({len(unclaimed)} unclaimed), {len(done)} closed")

if __name__ == "__main__":
    main(sys.argv[1] if len(sys.argv) > 1 else "docket")
