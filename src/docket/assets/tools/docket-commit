#!/usr/bin/env python3
"""Commit as a named party, without leaving that name behind for the next one.

Every party works from the same clone, as the same OS user, pushing with the
same key. So this authenticates nobody and is not meant to: a party that wants
to commit under another party's name always can. What it buys is that `git log`
answers "which party wrote this" for honest parties, which it cannot do today --
every commit in this repo reads `Your Name <you@example.com>` (r013).

Three things, none of which `git commit` does on its own:

1. Identity is passed per invocation, never written to config. `git config
   user.name agy` would set it for the WHOLE CLONE, so the next party's commit
   is authored `agy` -- confidently wrong attribution, which is worse than the
   placeholder's obviously-absent attribution. The shared clone makes config a
   race; an environment variable cannot race.

2. Author is the party, committer is left alone. The agent wrote it; the human's
   credential pushed it. `git log --format='%an / %cn'` shows both, which is the
   honest rendering of who did what.

3. A `Docket-Party:` trailer goes in the message. Unlike the author field it
   survives rebase and cherry-pick, and no other party's config can clobber it.

  tools/docket-commit --from claude -m "message"
  tools/docket-commit -F body.txt            # party from DOCKET_PARTY
"""
import os, sys, subprocess, tempfile

TRAILER = "Docket-Party"
# RFC 2606 reserves .invalid precisely so it can never reach a real mailbox.
DOMAIN  = "docket.invalid"


def die(msg):
    sys.stderr.write("docket-commit: " + msg + "\n")
    sys.exit(2)


def split_args(argv):
    """Pull out what we own; everything else is git's."""
    party = os.environ.get("DOCKET_PARTY", "")
    msg = path = None
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--from" and i + 1 < len(argv):
            party = argv[i + 1]; i += 2
        elif a.startswith("--from="):
            party = a.split("=", 1)[1]; i += 1
        elif a in ("-m", "--message") and i + 1 < len(argv):
            msg = argv[i + 1]; i += 2
        elif a in ("-F", "--file") and i + 1 < len(argv):
            path = argv[i + 1]; i += 2
        else:
            rest.append(a); i += 1
    return party, msg, path, rest


def with_trailer(text, party):
    """Append the trailer unless the message already carries one.

    Left alone if present, so an amend or a hand-written message that already
    names its party is not given a second, contradictory one.
    """
    lines = text.rstrip("\n").split("\n")
    if any(l.lower().startswith(TRAILER.lower() + ":") for l in lines):
        return text.rstrip("\n") + "\n"
    sep = "" if lines and lines[-1].strip() == "" else "\n"
    return text.rstrip("\n") + "\n" + sep + f"{TRAILER}: {party}\n"


def main():
    party, msg, path, rest = split_args(sys.argv[1:])
    if not party:
        die("no party: pass --from <party> or set DOCKET_PARTY")
    if not party.replace("-", "").isalnum():
        die(f"party {party!r} is not a plain name")
    if msg is None and path is None:
        die("no message: pass -m <message> or -F <file>")
    if msg is not None and path is not None:
        die("pass -m or -F, not both")

    text = msg if msg is not None else open(path, encoding="utf-8").read()

    fd, tmp = tempfile.mkstemp(prefix="docket-commit-", suffix=".txt")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(with_trailer(text, party))
        # Author only. The committer stays whoever the environment says, so the
        # human who owns the clone and the key remains the committer of record.
        env = dict(os.environ,
                   GIT_AUTHOR_NAME=party,
                   GIT_AUTHOR_EMAIL=f"{party}@{DOMAIN}",
                   DOCKET_PARTY=party)
        return subprocess.call(["git", "commit", "-F", tmp, *rest], env=env)
    finally:
        os.unlink(tmp)


if __name__ == "__main__":
    sys.exit(main())
