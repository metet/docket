# 5. An unreadable request must not invent a mismatch: no parseable front matter
#    means no author, which is the pre-r032 behaviour of contributing nothing.
#    This hook blocks only on disagreement, never on absence.
#
#    Called directly rather than through a commit. pre-commit runs docket-lint
#    first and rightly refuses a malformed filing, so a commit can never carry
#    one as far as commit-msg -- the case is reachable only at this level.
import importlib.util as _iu2, importlib.machinery as _im2
_hspec = _iu2.spec_from_loader("cmsg", _im2.SourceFileLoader(
    "cmsg", os.path.join(HOOKS, "commit-msg")))
_cmsg = _iu2.module_from_spec(_hspec)
_hspec.loader.exec_module(_cmsg)          # name is not __main__, so main() stays put

reset(d)
os.makedirs(os.path.join(d, "docket", "r004-broken"), exist_ok=True)
open(os.path.join(d, "docket", "r004-broken", "000-request.md"), "w").write("no front matter\n")
stage(d, "docket/r004-broken/000-request.md")
# request_author shells out to git in the process cwd, and this suite runs from
# the pre-commit hook with GIT_DIR and GIT_INDEX_FILE exported. Left in place
# they would point the read back at the real repository -- the same escape T14
# and the GENV filter above exist to stop.
_cwd = os.getcwd()
_saved = {k: os.environ.pop(k) for k in list(os.environ) if k.startswith("GIT_")}
try:
    os.chdir(d)
    _author = _cmsg.request_author("docket/r004-broken/000-request.md")
finally:
    os.chdir(_cwd)
    os.environ.update(_saved)
check("T22", "an unreadable request yields no author, so it cannot cause a mismatch",
      _author is None, repr(_author))
reset(d)
shutil.rmtree(d)

