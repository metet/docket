def ws_open(args, cwd, party="claude"):
    """docket_open from `cwd`, with the collision registry in force."""
    inp = "\n".join(json.dumps(x) for x in [INIT, tc("docket_open", args)]) + "\n"
    env = dict(os.environ, DOCKET_PARTY=party, DOCKET_STORE="docket",
