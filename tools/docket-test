def dn(kind, **kw):
    argv = [sys.executable, os.path.join(D, "tools", "docket-new"), kind,
            "--store", os.path.join(d, "docket"), "--from", kw.pop("frm")]
    for k, v in kw.items():
        argv += [f"--{k.replace('_','-')}", v]
    return subprocess.run(argv, input="b", capture_output=True, text=True).returncode

