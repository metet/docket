#!/usr/bin/env python3
"""Behavioural tests for docket-mcp. No dependencies, no framework.

Each check was written against a defect that reproduced first, so a failure here
names a bug that was once real rather than a style preference. Every case builds
a throwaway store with docket-init and drives the server over stdio the way a
client does, because most of these defects were invisible to inspection and only
showed up in what actually got written to a filing.

  python3 tools/docket-test        # exits 1 if anything fails
"""
import os, sys, json, shutil, subprocess, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
D    = os.path.dirname(HERE)
MCP  = os.path.join(HERE, "docket-mcp")
results = []

def server(lines, party="qwen", store="docket", cwd=None):
    inp = "\n".join(json.dumps(l) if isinstance(l, dict) else l for l in lines) + "\n"
    env = dict(os.environ, DOCKET_PARTY=party, DOCKET_STORE=store)
    p = subprocess.run(["python3", MCP], input=inp, capture_output=True, text=True, cwd=cwd, env=env)
    out = [json.loads(l) for l in p.stdout.splitlines() if l.strip().startswith("{")]
    return p.returncode, out, p.stderr

INIT = {"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}
def tc(name, args, i=2):
    return {"jsonrpc":"2.0","id":i,"method":"tools/call","params":{"name":name,"arguments":args}}

def fresh():
    d = tempfile.mkdtemp(prefix="dk-")
    subprocess.run(["python3", os.path.join(D,"tools","docket-init"), d, "--link"],
                   capture_output=True, text=True)
    return d

