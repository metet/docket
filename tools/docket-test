def outside_call(name, args, party="claude"):
    inp = "\n".join(json.dumps(x) for x in [INIT, tc(name, args)]) + "\n"
    env = dict(env_ws, DOCKET_PARTY=party, DOCKET_STORE="docket")
    pr = subprocess.run([sys.executable, MCP], input=inp, capture_output=True,
                        text=True, cwd=outside, env=env)
    r = next((m["result"] for m in (json.loads(l) for l in pr.stdout.splitlines()
                                    if l.strip().startswith("{"))
              if m.get("id") == 2), {})
    return r.get("isError"), r.get("content", [{}])[0].get("text", "")

