r = commit(d, "claude", "sweeping up")
check("T22", "attributing another party's filing to the operator is refused",
      r.returncode == 1,
      r.stderr.strip().splitlines()[-1][:120] if r.stderr.strip() else "")
check("T22", "the refusal names the filing author",
