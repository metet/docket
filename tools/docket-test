d32_standard = tempfile.mkdtemp(prefix="dk-r44-standard-")
p32_standard = subprocess.run(
    [sys.executable, os.path.join(D, "tools", "docket-init"), d32_standard],
    capture_output=True, text=True)
standard_store = os.path.join(d32_standard, "docket")
standard_assets = (".seq", "PROTOCOL.md", "PARTIES.md", "INDEX.md", "README.md")
check("T32", "standard initialization creates every canonical store asset",
      p32_standard.returncode == 0 and
      all(os.path.exists(os.path.join(standard_store, p)) for p in standard_assets),
      f"exit={p32_standard.returncode} contents="
      f"{os.listdir(standard_store) if os.path.isdir(standard_store) else []}")

for p in (d32_removed, d32_standard):
    shutil.rmtree(p)

# ---- T33: Windows paths and CRLF preserve protocol meaning (r047) ----
check("T33", "a Windows drive colon is not mistaken for a refs line number",
      docket_lib.parse_ref("C:/src/app.py") == ("C:/src/app.py", None),
      str(docket_lib.parse_ref("C:/src/app.py")))
check("T33", "a trailing line number splits after the Windows path",
      docket_lib.parse_ref("C:/src/app.py:42") == ("C:/src/app.py", 42),
      str(docket_lib.parse_ref("C:/src/app.py:42")))
d33 = tempfile.mkdtemp(prefix="dk-r47-crlf-")
crlf_path = os.path.join(d33, "filing.md")
with open(crlf_path, "wb") as f:
    f.write(b"---\r\nprotocol: docket/0.3\r\n---\r\nbody\r\n")
check("T33", "protocol reads normalize CRLF to LF",
      "\r" not in docket_lib.read(crlf_path), repr(docket_lib.read(crlf_path)))
shutil.rmtree(d33)

# ---- report ----
w = max(len(r[1]) for r in results)
fails = 0
for tid, desc, passed, detail in results:
    print(f"{tid}  {'PASS' if passed else 'FAIL'}  {desc:<{w}}  {detail if not passed else ''}")
    fails += not passed
print(f"\n{len(results)} checks, {fails} failing")
sys.exit(1 if fails else 0)
