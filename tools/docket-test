      waiting.replace("\n", "|")[:120])
# r003 is assigned to and waiting on qwen. It belongs in the plain listing and
# in none of the sections addressed to claude -- the new sections widen what a
# party is told it owns, so this is the check that they did not widen it too far.
main, _, sections = listing.partition("\n\n")
check("T18", "another party's work is listed but never claimed",
      "r003-active" in main and "r003-active" not in sections,
      f"main={('r003-active' in main)} sections={('r003-active' in sections)}")
shutil.rmtree(d)

# ---- T19: a filing may say only what it knows about its date (r010) ----
# Canonical order is (NNN, party) and does not use `date`, so the timestamp is
# load-bearing for nothing. Requiring precision a party lacks produced a
# fabricated midnight, which the lint then flagged as a placeholder.
d = fresh()
st = os.path.join(d, "docket")
subprocess.run(["python3", os.path.join(D, "tools", "docket-new"), "request",
                "--store", st, "--from", "claude", "--slug", "dates",
                "--title", "Dates", "--act", "task"],
               input="b", capture_output=True, text=True)
dk = os.path.join(st, "r001-dates")

def lint_of(name, date):
    open(os.path.join(dk, name), "w").write(
        f"---\nprotocol: docket/0.2\nid: r001/001-claude\ndocket: r001\n"
        f"from: claude\ntype: filing\nact: answer\ndate: {date}\n---\n\n# T\n\nb\n")
    r = subprocess.run(["python3", os.path.join(D, "tools", "docket-lint"), st],
                       capture_output=True, text=True)
    os.remove(os.path.join(dk, name))
    return r.returncode, r.stdout

rc, out = lint_of("001-claude-answer.md", "2026-08-29")
check("T19", "a plain calendar date is valid", rc == 0, out.strip().splitlines()[-1])
rc, out = lint_of("001-claude-answer.md", "2026-08-29T15:41:00Z")
check("T19", "a full timestamp is still valid", rc == 0, out.strip().splitlines()[-1])
rc, out = lint_of("001-claude-answer.md", "29/08/2026")
check("T19", "a date in neither form is rejected", rc != 0, out.strip().splitlines()[-1])
rc, out = lint_of("001-claude-answer.md", "2099-01-01")
check("T19", "a future plain date still warns", "is in the future" in out, out[:80])

# The filename rule stays -- 001-claude.md cannot be told from 001-answer.md --
# but the error now names the file it should have been, since both halves are in
# the front matter the party already wrote.
rc, out = lint_of("001-claude.md", "2026-08-29")
check("T19", "an ambiguous filename is still rejected", rc != 0, out[:80])
check("T19", "the filename error names the file it should have been",
      "001-claude-answer.md" in out, out[:160])
shutil.rmtree(d)

# ---- T20: the gate blames the commit, not the store (r011) ----
# An invalid filing cannot be repaired -- errata cannot correct a filename and
# rule 1 forbids a rename -- so a gate demanding a clean store is uninstallable
# in the one repo that has already earned it.
d = fresh()
st = os.path.join(d, "docket")
subprocess.run(["python3", os.path.join(D, "tools", "docket-new"), "request",
                "--store", st, "--from", "claude", "--slug", "g", "--title", "G",
                "--act", "task"], input="b", capture_output=True, text=True)
dk = os.path.join(st, "r001-g")
bad = os.path.join(dk, "001-claude.md")          # no <label>: invalid filename
open(bad, "w").write("---\nprotocol: docket/0.2\nid: r001/001-claude\n"
                     "docket: r001\nfrom: claude\ntype: filing\nact: answer\n"
                     "date: 2026-08-30\n---\n\n# B\n\nb\n")

def lint(*extra):
    return subprocess.run(["python3", os.path.join(D, "tools", "docket-lint"), st,
                           *extra], capture_output=True, text=True)

r = lint()
check("T20", "without --gate the store still fails", r.returncode == 1,
      r.stdout.strip().splitlines()[-1])
r = lint("--gate", bad)
check("T20", "the commit that introduces it is blocked", r.returncode == 1,
      r.stdout.strip().splitlines()[-1])
r = lint("--gate", os.path.join(dk, "000-request.md"))
check("T20", "a later commit elsewhere is not blamed for it", r.returncode == 0,
      r.stdout.strip().splitlines()[-1])
check("T20", "the pre-existing error is still reported", "ERROR" in r.stdout,
      r.stdout[:80])
r = lint("--gate")
check("T20", "--gate with no paths gates nothing", r.returncode == 0,
      r.stdout.strip().splitlines()[-1])

# A docket-level fault is the other shape: adding a filing can cause it, so any
# filing touched in that docket answers for it.
dk2 = os.path.join(st, "r002-orphan"); os.makedirs(dk2)
orph = os.path.join(dk2, "001-claude-answer.md")
open(orph, "w").write("---\nprotocol: docket/0.2\nid: r002/001-claude\n"
                      "docket: r002\nfrom: claude\ntype: filing\nact: answer\n"
                      "date: 2026-08-30\n---\n\n# O\n\nb\n")
r = lint("--gate", orph)
check("T20", "a docket-level fault gates any filing in that docket",
      r.returncode == 1 and "no 000-request" in r.stdout,
      r.stdout.strip().splitlines()[-1])
shutil.rmtree(d)

# ---- T21: the reader discloses validity (r009) ----
d = fresh()
st = os.path.join(d, "docket")
def mk(kind, **kw):
    argv = ["python3", os.path.join(D, "tools", "docket-new"), kind,
            "--store", st, "--from", kw.pop("frm")]
    for k, v in kw.items():
        argv += [f"--{k.replace('_','-')}", v]
    return subprocess.run(argv, input="b", capture_output=True, text=True)

# r001: open, holds a schema-invalid filing (no <label> in the filename)
mk("request", frm="claude", slug="scar", title="Scar", act="task", assignee="claude")
open(os.path.join(st, "r001-scar", "001-claude.md"), "w").write(
    "---\nprotocol: docket/0.2\nid: r001/001-claude\ndocket: r001\nfrom: claude\n"
    "type: filing\nact: answer\ndate: 2026-08-30\n---\n\n# Bad\n\nb\n")
# r002: an authority violation -- well formed, counts, one attempt ignored
mk("request", frm="claude", slug="auth", title="Auth", act="task", assignee="claude")
open(os.path.join(st, "r002-auth", "001-qwen-answer.md"), "w").write(
    "---\nprotocol: docket/0.2\nid: r002/001-qwen\ndocket: r002\nfrom: qwen\n"
    "type: filing\nact: answer\nassignee: qwen\ndate: 2026-08-30\n---\n\n# V\n\nb\n")

def read(dk):
    _, out, _ = server([INIT, tc("docket_read", {"docket": dk})], party="claude", cwd=d)
    return out[-1]["result"]["content"][0]["text"]

scar = read("r001")
check("T21", "an invalid filing is marked INVALID", "INVALID" in scar, scar[:80])
check("T21", "the marker says it reached no derived state",
      "excluded from this docket's derived state" in scar, scar[:80])
check("T21", "the reason is attributed to the right filing",
      scar.split("=== 001-claude.md ===")[1].count("filename MUST be") == 1
      and "filename MUST be" not in scar.split("=== 001-claude.md ===")[0],
      "reason landed on the wrong filing")

viol = read("r002")
# The trap: this filing counts. Calling it invalid would tell a reader to
# discount part of the record.
check("T21", "an authority violation is NOT called invalid",
      "INVALID" not in viol, viol[-200:])
check("T21", "a violation says the filing still stands",
      "This filing counts" in viol and "may not set assignee" in viol, viol[-160:])
check("T21", "a clean filing gets no validity note",
      ">" not in read("r002").split("=== 000-request.md ===")[1].split("===")[0],
      "annotated a clean filing")

_, out_l, _ = server([INIT, tc("docket_list", {})], party="claude", cwd=d)
listing = out_l[-1]["result"]["content"][0]["text"]
check("T21", "docket_list flags an open docket holding an invalid filing",
      "1 invalid filing" in listing, listing.replace("\n", "|")[:120])

# A closed docket is not listed at all, so its scar needs its own section --
# grandfathering (r011) must never mean hiding.
mk("close", frm="claude", docket="r001", title="Done", status="resolved",
   evidence="git:abc1234")
_, out_c, _ = server([INIT, tc("docket_list", {})], party="claude", cwd=d)
closed = out_c[-1]["result"]["content"][0]["text"]
check("T21", "a scar in a closed docket is still reported",
      "closed docket" in closed and "001-claude.md" in closed,
      closed.replace("\n", "|")[:140])
shutil.rmtree(d)

# ---- T22: git attribution matches the filings a commit carries (r013) ----
# Every party is the same OS user pushing the same key, so none of this
# authenticates anybody. It catches the honest mistake: a clone-wide
# `git config user.name` leaks one party's identity onto the next party's
# commit, which is worse than the placeholder because it reads as an answer.
COMMIT = os.path.join(D, "tools", "docket-commit")
HOOKS  = os.path.join(D, "tools", "git-hooks")

# Every GIT_* variable must go. This suite runs from the pre-commit hook, which
# exports GIT_DIR, GIT_INDEX_FILE and -- once docket-commit is what invoked it --
# GIT_AUTHOR_NAME. Inherited, they point these throwaway repos back at the real
# one and author its commits as whoever is committing, so the checks below would
# measure the developer's machine rather than the hook. Same defect as T14.
GENV = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}

def git(d, *a):
    return subprocess.run(["git", *a], cwd=d, capture_output=True, text=True, env=GENV)

def repo():
    d = fresh()
    for a in (["init", "-q", "."], ["config", "user.name", "Your Name"],
              ["config", "user.email", "you@example.com"],
              ["config", "core.hooksPath", HOOKS]):
        git(d, *a)
    open(os.path.join(d, "README.md"), "w").write("seed\n")
    git(d, "add", "README.md")
    git(d, "commit", "-qm", "seed")
    return d

def newf(d, **kw):
    args = ["python3", os.path.join(D, "tools", "docket-new"), kw.pop("kind"),
            "--store", "docket"]
    for k, v in kw.items():
        args += ["--" + k.replace("_", "-"), v]
    return subprocess.run(args, cwd=d, capture_output=True, text=True)

def stage(d, *paths):
    git(d, "add", *paths)

def commit(d, party=None, msg="m"):
    cmd = (["python3", COMMIT, "--from", party] if party else ["git", "commit"])
    return subprocess.run([*cmd, "-m", msg], cwd=d, capture_output=True,
                          text=True, env=GENV)

def show(d, fmt):
    return git(d, "log", "-1", "--format=" + fmt).stdout.strip()

d = repo()
newf(d, kind="request", **{"from": "claude", "slug": "x", "title": "X",
                           "act": "task", "body": "b"})
newf(d, kind="filing", docket="r001", **{"from": "claude", "act": "answer",
                                         "title": "A", "body": "b"})
newf(d, kind="filing", docket="r001", **{"from": "agy", "act": "answer",
                                         "title": "B", "body": "b"})
dk = "docket/r001-x"

stage(d, "docket/.seq", "docket/INDEX.md", dk + "/000-request.md",
      dk + "/001-claude-answer.md")
r = commit(d, "claude", "r001: claude answers")
check("T22", "a party commits its own filing", r.returncode == 0, r.stderr[:120])
check("T22", "the author is the party, not the placeholder",
      show(d, "%an") == "claude", show(d, "%an"))
check("T22", "the committer is left alone",
      show(d, "%cn") == "Your Name", show(d, "%cn"))
check("T22", "the party is recorded in a trailer",
      show(d, "%(trailers:key=Docket-Party,valueonly)").strip() == "claude",
      show(d, "%(trailers:key=Docket-Party,valueonly)"))

# Committing someone else's filing under your own name: §5b says a party commits
# only what it created, and this is that rule seen from the attribution side.
stage(d, dk + "/002-agy-answer.md")
r = commit(d, "claude", "sweeping up")
check("T22", "committing another party's filing is refused", r.returncode == 1,
      r.stderr.strip().splitlines()[-1][:120] if r.stderr.strip() else "")
check("T22", "the refusal names the party it should have been",
      "agy" in r.stderr, r.stderr[:120])

# A refused commit leaves its files staged, so clear the index before the next
# case -- otherwise agy's filing is still staged and the next check measures it
# rather than what it meant to.
def reset(d):
    git(d, "reset", "-q")

reset(d)
newf(d, kind="filing", docket="r001", **{"from": "claude", "act": "answer",
                                         "title": "C", "body": "b"})

# The leaked-identity case this exists for: config is clone-wide, so a plain
# commit after `git config user.name agy` authors claude's filing as agy.
git(d, "config", "user.name", "agy")
stage(d, dk + "/003-claude-answer.md", "docket/INDEX.md")
r = commit(d, None, "plain commit under a leaked identity")
check("T22", "a leaked clone-wide identity is caught", r.returncode == 1,
      r.stderr.strip().splitlines()[-1][:120] if r.stderr.strip() else "")

# The human owns the repo and does not answer to this hook.
git(d, "config", "user.name", "Your Name")
r = commit(d, None, "no party named")
check("T22", "an unnamed party is warned, never blocked", r.returncode == 0,
      r.stderr[:120])
check("T22", "the warning says what to do instead",
      "docket-commit" in r.stderr, r.stderr[:120])

# A tooling change has no filing to disagree with, so it must stay silent.
open(os.path.join(d, "README.md"), "a").write("more\n")
stage(d, "README.md")
r = commit(d, None, "tooling only")
check("T22", "a commit with no filings is not policed",
      r.returncode == 0 and "commit-msg:" not in r.stderr, r.stderr[:120])
shutil.rmtree(d)

# ---- report ----
w = max(len(r[1]) for r in results)
fails = 0
for tid, desc, passed, detail in results:
    print(f"{tid}  {'PASS' if passed else 'FAIL'}  {desc:<{w}}  {detail if not passed else ''}")
    fails += not passed
print(f"\n{len(results)} checks, {fails} failing")
sys.exit(1 if fails else 0)
