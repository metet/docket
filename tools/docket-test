def roots_session(caps, answer, cwd, store_env="docket", tool="docket_list"):
    """Drive a live server, answering a roots/list request if one arrives.

    Pinned to an empty workspace allowlist. Without that the server reads the
    developer's real config, and a machine that happens to trust a store makes
    these checks pass or fail on local state rather than on the code.
    """
    env = dict(os.environ, DOCKET_PARTY="claude", DOCKET_STORE=store_env,
               DOCKET_WORKSPACES_FILE=_empty_ws)
    pr = subprocess.Popen(["python3", MCP], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, text=True, bufsize=1, env=env, cwd=cwd)
    wr = lambda m: (pr.stdin.write(json.dumps(m) + "\n"), pr.stdin.flush())
    rd = lambda: json.loads(pr.stdout.readline())
    wr({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":caps}}); rd()
    args = ({"slug":"s","title":"t","body":"b"} if tool == "docket_open" else {})
    wr({"jsonrpc":"2.0","id":2,"method":"tools/call",
        "params":{"name":tool,"arguments":args}})
    m, asked = rd(), False
    if m.get("method") == "roots/list":
        asked = True
        wr(answer(m["id"])); m = rd()
    pr.stdin.close(); pr.wait(timeout=20)
    return asked, m["result"]["content"][0]["text"], m["result"]["isError"]

