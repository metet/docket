#!/usr/bin/env python3
"""Docket over MCP — stdio JSON-RPC 2.0, no dependencies.

Exposes docket verbs, not messaging verbs: every exchange belongs to a request
with a lifecycle and a terminal state.

Writes shell out to `docket-new` rather than reimplementing anything, so the
MCP path and the CLI path cannot drift apart. Reads use docket_lib, the same
model docket-lint and docket-index use.

Identity comes from DOCKET_PARTY, set once when the server is registered. There
is no `from` argument on any tool, so a model cannot claim to be another party.

Registration:
  qwen   mcp add docket python3 /path/to/tools/docket-mcp -e DOCKET_PARTY=qwen   -e DOCKET_STORE=docket --trust
  claude mcp add docket -e DOCKET_PARTY=claude -e DOCKET_STORE=docket -- python3 /path/to/tools/docket-mcp
"""
import sys, os, json, subprocess

HERE     = os.path.dirname(os.path.abspath(__file__))
NEW      = os.path.join(HERE, "docket-new")
PARTY    = os.environ.get("DOCKET_PARTY", "")
STORE    = os.environ.get("DOCKET_STORE", "docket")
PROTOCOL = "2024-11-05"
sys.path.insert(0, HERE)

# Set from the client's initialize. A roots/list request to a client that never
# answers would hang this process forever, so it is only ever sent to a client
# that declared the capability.
CLIENT_ROOTS = False
_pending = []        # client messages read while awaiting a server->client reply
_rpc_id  = 0
_store   = None      # resolved lazily, then cached

def log(*a):                      # stdout is the protocol channel; never print there
    print(*a, file=sys.stderr, flush=True)

def send(msg):
    sys.stdout.write(json.dumps(msg) + "\n"); sys.stdout.flush()

def ok(i, result):  send({"jsonrpc": "2.0", "id": i, "result": result})
def err(i, code, m): send({"jsonrpc": "2.0", "id": i, "error": {"code": code, "message": m}})
def text(s, is_error=False):
    return {"content": [{"type": "text", "text": s}], "isError": is_error}

def client_request(method, params=None):
    """Send a server->client request and wait for its response.

    The main loop and this share one stdin, so anything read here that is not
    the reply is queued for the loop rather than dropped.
    """
    global _rpc_id
    _rpc_id += 1
    rid = f"srv-{_rpc_id}"
    send({"jsonrpc": "2.0", "id": rid, "method": method, **({"params": params} if params else {})})
    while True:
        line = sys.stdin.readline()
        if not line:
            return None                      # client went away
        if not line.strip():
            continue
        try:
            m = json.loads(line)
        except json.JSONDecodeError:
            _pending.append(line); continue
        if isinstance(m, dict) and m.get("id") == rid:
            return m.get("result")           # None when the client errored
        _pending.append(line)

def store():
    """The store path, resolved once.

    DOCKET_STORE is relative by design: it names the store inside whichever
    repository the client is working in, so one registration serves every repo.
    Resolving it against this process's cwd was wrong — the cwd is the client's,
    which for an editor or a session started elsewhere is not the repository at
    all, and every call failed with FileNotFoundError.

    Ask the client where its workspace actually is. An absolute DOCKET_STORE
    bypasses this entirely, and a relative one that already resolves is used as
    is, so a working setup never pays for the round trip.
    """
    global _store
    if _store is not None:
        return _store
    if os.path.isabs(STORE) or os.path.isdir(STORE):
        _store = STORE
        return _store
    if CLIENT_ROOTS:
        roots = client_request("roots/list") or {}
        for r in roots.get("roots") or []:
            uri = r.get("uri") or ""
            path = uri[7:] if uri.startswith("file://") else uri
            cand = os.path.join(path, STORE)
            if os.path.isdir(cand):
                log(f"docket-mcp: store resolved via roots -> {cand}")
                _store = cand
                return _store
    _store = STORE                            # unresolved; fail with a real path
    return _store

S = lambda d="": {"type": "string", **({"description": d} if d else {})}

def A(title, read_only, destructive=False, idempotent=False):
    """Tool annotations, so a host can tell reads from writes.

    Without these a host has one switch for the whole server: prompt on every
    call, or trust all of them. That is the wrong granularity here — reading a
    docket is safe, and filing one puts an immutable record in front of another
    party. openWorldHint is false throughout: every tool acts on the local
    store and reaches nothing outside it.

    destructiveHint defaults to true in the spec, so saying false is the
    informative case: filings are append-only and never overwrite. Only
    docket_close is left destructive — it appends like the rest, but the
    terminal status it sets cannot be reversed by any later filing.
    """
    a = {"title": title, "readOnlyHint": read_only, "openWorldHint": False}
    if not read_only:
        a["destructiveHint"] = destructive
        a["idempotentHint"] = idempotent
    return a


TOOLS = [
  {"name": "docket_list",
   "description": "List open dockets: status, assignee, and which party each is waiting on. "
                  "Call this first in a session — anything waiting on you is yours to advance.",
   "inputSchema": {"type": "object", "properties": {}, "required": []},
   "annotations": A("List open dockets", read_only=True)},
  {"name": "docket_read",
   "description": "Read every filing in one docket, in canonical order.",
   "inputSchema": {"type": "object",
                   "properties": {"docket": S("docket id, e.g. r004")},
                   "required": ["docket"]},
   "annotations": A("Read a docket", read_only=True)},
  {"name": "docket_open",
   "description": "Open a new docket: a question, task, review or report that needs an answer. "
                  "Use for anything whose outcome should be findable later.",
   "inputSchema": {"type": "object", "properties": {
       "slug":     S("short-kebab-name, e.g. grid-spacing"),
       "title":    S("one line stating the question or task"),
       "body":     S("the full request, in Markdown"),
       "act":      {"type": "string", "enum": ["question","task","review","report"]},
       "to":       S("comma-separated party names"),
       "assignee": S("party responsible for advancing it"),
       "status":   {"type": "string", "enum": ["open", "resolved"],
                    "description": "defaults to open, or resolved for act: report. "
                                   "Set open on a report that does need a reply."}},
    "required": ["slug", "title", "body"]},
   "annotations": A("Open a docket", read_only=False, destructive=False)},
  {"name": "docket_file",
   "description": "Add a filing to an existing docket — an answer, an objection, an "
                  "acknowledgement, or a correction. Does not close it.",
   "inputSchema": {"type": "object", "properties": {
       "docket":   S("docket id, e.g. r004"),
       "title":    S("one line summarising this filing"),
       "body":     S("the filing, in Markdown"),
       "act":      {"type": "string", "enum": ["answer","objection","ack","review","report","erratum"]},
       "parent":   S("filing id this responds to, e.g. r004/000"),
       "supersedes": S("with act: erratum — the filing id being corrected, "
                       "e.g. r004/001-qwen. You may only correct your own."),
       "corrects":   S("with act: erratum — comma-separated field names to "
                       "correct; supply the new values as ordinary arguments"),
       "to":       S("comma-separated party names"),
       "assignee": S("party responsible for advancing it; claim an unclaimed "
                     "docket by filing act: ack with yourself as assignee"),
       "refs":     S("comma-separated path:line references"),
       "evidence": S("comma-separated proof: commit sha, command output, a file"),
       "status":   {"type": "string", "enum": ["open","blocked"]},
       "blocked_on": S("party or condition being waited on")},
    "required": ["docket", "title", "body"]},
   "annotations": A("Add a filing", read_only=False, destructive=False)},
  {"name": "docket_close",
   "description": "Close a docket you opened. Only the requester may close; if you are not, "
                  "file an answer proposing closure instead. Attach evidence pointing outward.",
   "inputSchema": {"type": "object", "properties": {
       "docket":   S("docket id, e.g. r004"),
       "title":    S("one line stating the outcome"),
       "body":     S("what was decided and why"),
       "evidence": S("comma-separated proof: commit sha, command output, a file outside the store"),
       "status":   {"type": "string", "enum": ["resolved", "withdrawn"]}},
    "required": ["docket", "title", "body"]},
   "annotations": A("Close a docket", read_only=False, destructive=True)},
  {"name": "docket_protocol",
   "description": "Return the Docket protocol's quick start: how to file, who may close, "
                  "and the rules most often broken. Read this before your first filing.",
   "inputSchema": {"type": "object", "properties": {}, "required": []},
   "annotations": A("Read the Docket protocol", read_only=True)},
]

def missing_required(name, args):
    """Required arguments absent from a call, per the tool's own schema.

    Without this the first thing to touch a missing field raised, and the model
    got "KeyError: 'title'" — the right shape for MCP, but it names a Python
    dict lookup rather than the argument it forgot.
    """
    spec = next((t for t in TOOLS if t["name"] == name), None)
    if not spec:
        return []
    return [k for k in spec["inputSchema"].get("required", []) if not args.get(k)]

def run_new(kind, args):
    from docket_lib import quote_flow
    """Every write goes through docket-new: one implementation, no drift.
    argv is built as a list, so no argument can inject a flag."""
    if not PARTY:
        return text("DOCKET_PARTY is not set, so this server has no identity. "
                    "Re-register it with -e DOCKET_PARTY=<your party name>.", True)
    argv = ["python3", NEW, kind, "--store", store(), "--from", PARTY,
            "--title", args["title"]]
    for flag, key in (("--slug","slug"), ("--docket","docket"), ("--act","act"),
                      ("--to","to"), ("--assignee","assignee"), ("--parent","parent"),
                      ("--refs","refs"), ("--evidence","evidence"),
                      ("--supersedes","supersedes"), ("--corrects","corrects"),
                      ("--status","status"), ("--blocked-on","blocked_on")):
        v = args.get(key)
        if not v:
            continue
        # Models routinely pass a JSON array for the comma-separated fields.
        # str() on a list yields "['a', 'b']", which docket-new then splits on
        # the comma into two bracketed fragments, so the corruption reaches the
        # filing rather than being rejected.
        # quote_flow keeps an item that contains a comma from being split back
        # into two by docket-new's own comma parsing.
        argv += [flag, ", ".join(quote_flow(x) for x in v) if isinstance(v, list) else str(v)]
    p = subprocess.run(argv, input=args.get("body", ""), capture_output=True, text=True)
    if p.returncode != 0:
        return text((p.stderr or p.stdout).strip() or "docket-new failed", True)
    path = p.stdout.strip()
    subprocess.run(["python3", os.path.join(HERE, "docket-index"), store()],
                   capture_output=True, text=True)
    return text(f"filed {path}")

def call(name, args):
    from docket_lib import dockets, validate_docket, load, read, apply_errata
    miss = missing_required(name, args)
    if miss:
        return text(f"{name}: missing required argument"
                    f"{'s' if len(miss) > 1 else ''}: {', '.join(miss)}", True)
    # docket_protocol can answer from the source tree, so it needs no store.
    if name != "docket_protocol" and not os.path.isdir(store()):
        return text(
            f"no docket store at {os.path.abspath(store())!r}.\n"
            f"DOCKET_STORE={STORE!r} is relative and this server's working "
            f"directory is {os.getcwd()!r}.\n"
            + ("The client offered no workspace root — it did not declare the "
               "roots capability.\n" if not CLIENT_ROOTS else
               "No workspace root the client offered contains it.\n")
            + "Fix by one of: run the client from the repository; set "
              "DOCKET_STORE to an absolute path; or scaffold a store there with "
              "docket-init.", True)
    if name == "docket_list":
        rows, mine = [], []
        st_path = store()
        for d in dockets(st_path):
            _, _, _, _, st = validate_docket(st_path, d)
            if st["status"] in ("resolved", "withdrawn"):
                continue
            row = (f"{d}  status={st['status']}  assignee={st['assignee'] or '-'}  "
                   f"waiting_on={st.get('waiting_on') or '-'}")
            rows.append(row)
            # Compare the reduced state, not the rendered row. Substring matching
            # on "waiting_on=" claimed every open docket for an unset party, and
            # let a party whose name is a prefix of another ("qwe" against
            # "qwen") claim that party's work.
            if PARTY and st.get("waiting_on") == PARTY:
                mine.append(row)
        out = "\n".join(rows) or "No open dockets."
        if mine:
            out += f"\n\n{len(mine)} waiting on you ({PARTY}):\n" + "\n".join("  " + m for m in mine)
        return text(out)
    if name == "docket_read":
        did = args["docket"].split("-")[0]
        st_path = store()
        for d in dockets(st_path):
            if d.split("-")[0] == did:
                out = []
                # Errata are what docket-lint and docket-index reduce against.
                # Reading raw text alone showed a superseded value as if it were
                # current. The filing is immutable, so it is shown as written and
                # the correction is stated under it rather than edited into it.
                for f in apply_errata(load(os.path.join(st_path, d))):
                    block = f"=== {f['fn']} ===\n{f['text']}"
                    if f.get("corrected"):
                        block += "\n> corrected by a later erratum:\n" + "\n".join(
                            f">   {k}: {f['fm'].get(k, '(retracted)')}"
                            for k in sorted(f["corrected"]))
                    out.append(block)
                return text("\n\n".join(out))
        return text(f"no docket {did} in {st_path}/", True)
    if name == "docket_protocol":
        for cand in (os.path.join(store(), "PROTOCOL.md"), os.path.join(HERE, "..", "PROTOCOL.md")):
            if os.path.exists(cand):
                t = read(cand)
                i = t.find("## 1.")
                return text(t[:i] if i > 0 else t[:6000])
        return text("PROTOCOL.md not found", True)
    if name in ("docket_open", "docket_file", "docket_close"):
        return run_new({"docket_open": "request", "docket_file": "filing",
                        "docket_close": "close"}[name], args)
    return text(f"unknown tool {name}", True)

def main():
    global CLIENT_ROOTS, _store
    log(f"docket-mcp: party={PARTY or '(unset)'} store={STORE}")
    while True:
        # Anything client_request read while waiting for its reply is handled
        # here first, so a roots round trip never swallows a tool call.
        if _pending:
            line = _pending.pop(0)
        else:
            line = sys.stdin.readline()
            if not line:
                break
        if not line.strip():
            continue
        try:
            m = json.loads(line)
        except json.JSONDecodeError as e:
            err(None, -32700, f"parse error: {e}"); continue
        # Valid JSON that is not an object still has no .get: a bare array or
        # scalar reached m.get() below and killed the process, dropping the
        # connection -- the one thing the handler at the end of this loop exists
        # to prevent.
        if not isinstance(m, dict):
            err(None, -32600, f"invalid request: expected an object, got {type(m).__name__}")
            continue
        method, mid = m.get("method"), m.get("id")
        try:
            if method == "initialize":
                caps = ((m.get("params") or {}).get("capabilities") or {})
                CLIENT_ROOTS = "roots" in caps
                log(f"docket-mcp: client roots capability = {CLIENT_ROOTS}")
                ok(mid, {"protocolVersion": PROTOCOL, "capabilities": {"tools": {}},
                         "serverInfo": {"name": "docket", "version": "0.2"}})
            elif method == "notifications/roots/list_changed":
                _store = None                # re-resolve against the new roots
            elif method in ("notifications/initialized", "notifications/cancelled"):
                pass
            elif method == "ping":
                ok(mid, {})
            elif method == "tools/list":
                ok(mid, {"tools": TOOLS})
            elif method == "tools/call":
                params = m.get("params") or {}
                name = params.get("name")
                if not isinstance(name, str) or not name:
                    err(mid, -32602, "invalid params: tools/call requires a tool name")
                else:
                    ok(mid, call(name, params.get("arguments") or {}))
            elif mid is not None:
                err(mid, -32601, f"method not found: {method}")
        except Exception as e:                       # never die on one bad call
            log(f"error in {method}: {e}")
            if mid is None:
                continue
            # A tool that fails is reported in band, as an isError result the
            # model can read and act on. Anything else must answer with a
            # JSON-RPC error: a client awaiting InitializeResult or
            # ListToolsResult fails schema validation on a CallToolResult and
            # drops the connection rather than surfacing the problem.
            if method == "tools/call":
                ok(mid, text(f"{type(e).__name__}: {e}", True))
            else:
                err(mid, -32603, f"internal error: {type(e).__name__}: {e}")

if __name__ == "__main__":
    main()
