#!/usr/bin/env python3
"""Docket over MCP — stdio JSON-RPC 2.0, no dependencies.

Exposes docket verbs, not messaging verbs: every exchange belongs to a request
with a lifecycle and a terminal state.

Writes shell out to `docket-new` rather than reimplementing anything, so the
MCP path and the CLI path cannot drift apart. Reads use docket_lib, the same
model docket-lint and docket-index use.

Identity comes from DOCKET_PARTY, set once when the server is registered. There
is no `from` argument on any tool, so a model cannot claim to be another party.

Registration:
  qwen   mcp add docket python3 /path/to/tools/docket-mcp -e DOCKET_PARTY=qwen   -e DOCKET_STORE=docket --trust
  claude mcp add docket -e DOCKET_PARTY=claude -e DOCKET_STORE=docket -- python3 /path/to/tools/docket-mcp
"""
import sys, os, json, subprocess

HERE     = os.path.dirname(os.path.abspath(__file__))
NEW      = os.path.join(HERE, "docket-new")
PARTY    = os.environ.get("DOCKET_PARTY", "")
STORE    = os.environ.get("DOCKET_STORE", "docket")
PROTOCOL = "2024-11-05"
sys.path.insert(0, HERE)

# Set from the client's initialize. A roots/list request to a client that never
# answers would hang this process forever, so it is only ever sent to a client
# that declared the capability.
CLIENT_ROOTS = False
_pending = []        # client messages read while awaiting a server->client reply
_rpc_id  = 0
_store   = None      # resolved lazily, then cached

def log(*a):                      # stdout is the protocol channel; never print there
    print(*a, file=sys.stderr, flush=True)

def send(msg):
    sys.stdout.write(json.dumps(msg) + "\n"); sys.stdout.flush()

def ok(i, result):  send({"jsonrpc": "2.0", "id": i, "result": result})
def err(i, code, m): send({"jsonrpc": "2.0", "id": i, "error": {"code": code, "message": m}})
def text(s, is_error=False):
    return {"content": [{"type": "text", "text": s}], "isError": is_error}

def client_request(method, params=None):
    """Send a server->client request and wait for its response.

    The main loop and this share one stdin, so anything read here that is not
    the reply is queued for the loop rather than dropped.
    """
    global _rpc_id
    _rpc_id += 1
    rid = f"srv-{_rpc_id}"
    send({"jsonrpc": "2.0", "id": rid, "method": method, **({"params": params} if params else {})})
    while True:
        line = sys.stdin.readline()
        if not line:
            return None                      # client went away
        if not line.strip():
            continue
        try:
            m = json.loads(line)
        except json.JSONDecodeError:
            _pending.append(line); continue
        if isinstance(m, dict) and m.get("id") == rid:
            return m.get("result")           # None when the client errored
        _pending.append(line)

def store():
    """The store path, resolved once.

    DOCKET_STORE is relative by design: it names the store inside whichever
    repository the client is working in, so one registration serves every repo.
    Resolving it against this process's cwd was wrong — the cwd is the client's,
    which for an editor or a session started elsewhere is not the repository at
    all, and every call failed with FileNotFoundError.

    Order of resolution:
    1. If DOCKET_STORE is absolute or resolves directly from cwd, use it.
    2. Check trusted workspaces in ~/.config/docket/workspaces: if this process's
       cwd is inside a registered workspace, resolve to <workspace>/<STORE>.
    3. If the client declared the roots capability, ask the client for roots.
    """
    global _store
    if _store is not None:
        return _store
    if os.path.isabs(STORE) or os.path.isdir(STORE):
        _store = STORE
        return _store
    from docket_lib import match_workspace
    ws = match_workspace(os.getcwd())
    if ws:
        cand = workspace_store(ws)
        if os.path.isdir(cand):
            log(f"docket-mcp: store resolved via trusted workspace -> {cand}")
            _store = cand
            return _store
    if CLIENT_ROOTS:
        roots = client_request("roots/list") or {}
        for r in roots.get("roots") or []:
            uri = r.get("uri") or ""
            path = uri[7:] if uri.startswith("file://") else uri
            cand = workspace_store(path)
            if os.path.isdir(cand):
                log(f"docket-mcp: store resolved via roots -> {cand}")
                _store = cand
                return _store
    _store = STORE                            # unresolved; fail with a real path
    return _store

def workspace_store(ws):
    """Find the docket store directory inside a given workspace path.
    Even if DOCKET_STORE was passed as an absolute path (e.g. from another project),
    the workspace store inside ws is located under ws.
    """
    name = os.path.basename(STORE.rstrip("/")) if os.path.isabs(STORE) else STORE
    cand = os.path.join(ws, name)
    if os.path.isdir(cand):
        return cand
    cand_default = os.path.join(ws, "docket")
    if os.path.isdir(cand_default):
        return cand_default
    return cand


S = lambda d="": {"type": "string", **({"description": d} if d else {})}

def A(title, read_only, destructive=False, idempotent=False):
    """Tool annotations, so a host can tell reads from writes.

    Without these a host has one switch for the whole server: prompt on every
    call, or trust all of them. That is the wrong granularity here — reading a
    docket is safe, and filing one puts an immutable record in front of another
    party. openWorldHint is false throughout: every tool acts on the local
    store and reaches nothing outside it.

    destructiveHint defaults to true in the spec, so saying false is the
    informative case: filings are append-only and never overwrite. Only
    docket_close is left destructive — it appends like the rest, but the
    terminal status it sets cannot be reversed by any later filing.
    """
    a = {"title": title, "readOnlyHint": read_only, "openWorldHint": False}
    if not read_only:
        a["destructiveHint"] = destructive
        a["idempotentHint"] = idempotent
    return a


