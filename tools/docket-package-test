#!/usr/bin/env python3
"""Smoke-test built Docket wheel and source-distribution artifacts."""
from pathlib import Path
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import venv
import zipfile


ROOT = Path(__file__).resolve().parent.parent
DIST = Path(sys.argv[1] if len(sys.argv) > 1 else ROOT / "dist").resolve()


def one(pattern):
    matches = sorted(DIST.glob(pattern))
    if len(matches) != 1:
        raise SystemExit(f"expected one {pattern} in {DIST}, found {len(matches)}")
    return matches[0]


wheel = one("docket-*.whl")
sdist = one("docket-*.tar.gz")
required = {
    "docket/assets/PROTOCOL.md",
    "docket/assets/tools/docket-mcp",
    "docket/assets/tools/docket-init",
    "docket/assets/tools/docket_lib.py",
    "docket/assets/tools/git-hooks/pre-commit",
    "docket/assets/tools/git-hooks/commit-msg",
}
with zipfile.ZipFile(wheel) as archive:
    names = set(archive.namelist())
    missing = sorted(required - names)
    if missing:
        raise SystemExit("wheel is missing: " + ", ".join(missing))
    metadata_name = next(n for n in names if n.endswith(".dist-info/METADATA"))
    metadata = archive.read(metadata_name).decode("utf-8")
    if "mcp-name: io.github.metet/docket" not in metadata:
        raise SystemExit("wheel metadata is missing the MCP ownership token")
    entry_name = next(n for n in names if n.endswith(".dist-info/entry_points.txt"))
    entries = archive.read(entry_name).decode("utf-8")
    for command in ("docket", "docket-mcp", "docket-init", "docket-workspace",
                    "docket-lint", "docket-new", "docket-index", "docket-commit"):
        if command + " =" not in entries:
            raise SystemExit("wheel has no console entry point: " + command)

with tarfile.open(sdist, "r:gz") as archive:
    suffixes = {"/pyproject.toml", "/server.json", "/src/docket/assets/PROTOCOL.md"}
    names = archive.getnames()
    missing = sorted(s for s in suffixes if not any(n.endswith(s) for n in names))
    if missing:
        raise SystemExit("sdist is missing: " + ", ".join(missing))

tmp = Path(tempfile.mkdtemp(prefix="docket-package-"))
try:
    env_dir = tmp / "venv"
    venv.EnvBuilder(with_pip=True).create(str(env_dir))
    if os.name == "nt":
        python = env_dir / "Scripts" / "python.exe"
    else:
        python = env_dir / "bin" / "python"
    install = subprocess.run(
        [str(python), "-m", "pip", "install", "--no-deps", str(wheel)],
        capture_output=True, text=True)
    if install.returncode:
        raise SystemExit(install.stdout + install.stderr)

    project = tmp / "project"
    project.mkdir()
    init = subprocess.run([str(python), "-m", "docket", "init", str(project)],
                          capture_output=True, text=True)
    if init.returncode:
        raise SystemExit(init.stdout + init.stderr)
    if (project / "docket" / "PROTOCOL.md").read_bytes() != \
            (ROOT / "PROTOCOL.md").read_bytes():
        raise SystemExit("installed docket-init scaffolded a different protocol")

    subprocess.run(["git", "init", str(project)], capture_output=True, text=True,
                   check=True)
    nested = project / "src" / "nested"
    nested.mkdir(parents=True)
    request = "\n".join((
        json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}}),
        json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                    "params": {"name": "docket_list", "arguments": {}}}),
        "",
    ))
    env = dict(os.environ, DOCKET_PARTY="human")
    mcp = subprocess.run([str(python), "-m", "docket.mcp"], input=request,
                         capture_output=True, text=True, cwd=nested, env=env)
    replies = [json.loads(line) for line in mcp.stdout.splitlines() if line.strip()]
    result = next((x.get("result", {}) for x in replies if x.get("id") == 2), {})
    if mcp.returncode or result.get("isError"):
        raise SystemExit("installed MCP smoke failed: " + mcp.stdout + mcp.stderr)
finally:
    shutil.rmtree(tmp)

print(f"package artifacts OK: {wheel.name}, {sdist.name}")
